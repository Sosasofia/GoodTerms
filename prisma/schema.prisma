generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  clerkId   String?  @unique
  guestId   String?  @unique  
  name      String   @unique
  email     String?  
  
  groups    Group[]  @relation("GroupMembers") 
  expensesPaid   Expense[] @relation("Payer")
  debtsOwed      Split[]   @relation("Debtor")
  sentMoney      Settlement[] @relation("Sender")
  receivedMoney  Settlement[] @relation("Receiver")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique // e.g. "TRIP-2026"
  createdAt DateTime @default(now())

  members   User[]   @relation("GroupMembers")
  expenses  Expense[]
  settlements Settlement[]
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  note        String?
  createdAt   DateTime @default(now())
  
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id])

  payerId     String   
  payer       User     @relation("Payer", fields: [payerId], references: [id])
  splits      Split[]
}

model Split {
  id        Int     @id @default(autoincrement())
  amount    Float
  isPaid    Boolean @default(false)

  expenseId Int
  expense   Expense @relation(fields: [expenseId], references: [id])
  debtorId  String  
  debtor    User    @relation("Debtor", fields: [debtorId], references: [id])
}

model Settlement {
  id          Int      @id @default(autoincrement())
  amount      Float
  createdAt   DateTime @default(now())

  groupId     String
  group       Group    @relation(fields: [groupId], references: [id])

  senderId    String   
  sender      User     @relation("Sender", fields: [senderId], references: [id])

  receiverId  String   
  receiver    User     @relation("Receiver", fields: [receiverId], references: [id])
}